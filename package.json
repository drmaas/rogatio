{
  "name": "rogatio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false .",
    "lint": "biome check --formatter-enabled=false --linter-enabled=true .",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.ts",
    "test": "pnpm build && vitest run",
    "test:browser": "pnpm build && vitest run --config vitest.browser.config.ts",
    "browser:install": "node scripts/install-browser.ts",
    "validate": "node scripts/validate.ts",
    "release": "semantic-release",
    "check": "biome check .",
    "prepare": "husky",
    "site": "pnpm --filter @rogatio/docs-site dev",
    "site:build": "pnpm --filter @rogatio/docs-site build",
    "site:preview": "pnpm --filter @rogatio/docs-site preview"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@puppeteer/browsers": "3.2.2",
    "@semantic-release/changelog": "7.0.0",
    "@types/node": "26.6.1",
    "@types/selenium-webdriver": "4.35.7",
    "esbuild": "0.28.2",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "selenium-webdriver": "4.49.0",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@peculiar/x509": "^2.1.0",
    "reflect-metadata": "^0.2.2"
  }
}
