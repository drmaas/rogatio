{
  "name": "@rogatio/requestly-import",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure Requestly export → Rogatio project mapping.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/node/index.js"
    }
  },
  "scripts": {
    "format": "biome format --write src test",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false src test",
    "lint": "biome check --formatter-enabled=false --linter-enabled=true src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "build": "node ../../scripts/build.ts"
  },
  "dependencies": {
    "@rogatio/schema": "workspace:*"
  },
  "devDependencies": {
    "@rogatio/compiler": "workspace:*",
    "@types/node": "26.6.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
