exports[`formatMatchRecord > formats redirect, query, and header snapshots with ANSI and field order > header 1`] = `"[1;34m[rogatio][m matched GET script https://example.com/page [2mheader-rule Header Rule header request set x-api-key=[redacted][m"`;

